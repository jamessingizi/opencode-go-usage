{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-go-usage",
  "version": "0.1.0",
  "description": "OpenCode Go subscription usage (5-hour / weekly / monthly) in the OpenCode TUI sidebar",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "usage",
    "quota"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "usage": "bun scripts/usage.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "peerDependencies": {
    "@opencode/theme": ">=2.3.2",
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.2",
    "@opencode/theme": "2.3.2",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.12.2",
    "solid-js": "1.9.17",
    "typescript": "^5.9.3"
  }
}
